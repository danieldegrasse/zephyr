config CLOCK_MANAGEMENT_NXP_KINETIS
	bool
	help
	  NXP Kinetis clock management drivers

config CLOCK_MANAGEMENT_NXP_KINETIS_OSC
	bool "NXP Kinetis system oscillator driver"
	default y
	depends on DT_HAS_NXP_KINETIS_OSC_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis system oscillator (OSC) driver. Programs the oscillator
	  range, gain and load capacitance from devicetree properties.

config CLOCK_MANAGEMENT_NXP_KINETIS_CLOCK_GATE
	bool "NXP Kinetis 8-bit clock gate driver"
	default y
	depends on DT_HAS_NXP_KINETIS_CLOCK_GATE_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis clock gate driver for gates within the 8-bit MCG and OSC
	  register blocks.

config CLOCK_MANAGEMENT_NXP_KINETIS_RTC_OSC
	bool "NXP Kinetis RTC oscillator driver"
	default y
	depends on DT_HAS_NXP_KINETIS_RTC_OSC_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis 32.768 kHz RTC oscillator driver

config CLOCK_MANAGEMENT_NXP_KINETIS_RTC_CLKOUT
	bool "NXP Kinetis RTC 32 kHz clock output driver"
	default y
	depends on DT_HAS_NXP_KINETIS_RTC_CLKOUT_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis driver for the RTC_CR[CLKO] gate, which controls whether
	  the RTC 32 kHz clock is output to other peripherals.

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG_FCRDIV
	bool "NXP Kinetis MCG fast IRC divider driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_FCRDIV_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCG fast internal reference clock divider (FCRDIV) driver

if CLOCK_MANAGEMENT_NXP_KINETIS

config NXP_KINETIS_CLOCK_TIMEOUT
	int "NXP Kinetis clock status timeout (in microseconds)"
	default 1000000
	help
	  Timeout value for waiting on MCG status bits (CLKST, IREFST, PLLST,
	  IRCST, LOCK0 and OSCINIT0) to reflect a new configuration. The
	  longest expected wait is crystal oscillator startup, which can take
	  up to one second for a 32 kHz crystal.

endif # CLOCK_MANAGEMENT_NXP_KINETIS

config NXP_KINETIS_RTC_OSC_STARTUP_DELAY
	int "NXP Kinetis RTC oscillator startup delay (in microseconds)"
	default 0
	depends on CLOCK_MANAGEMENT_NXP_KINETIS_RTC_OSC
	help
	  Time to wait after enabling the RTC oscillator before it is treated
	  as stable. The RTC oscillator has no ready status bit. Boards that
	  use the RTC oscillator as an MCG reference should set this to the
	  crystal startup time from the device datasheet.
