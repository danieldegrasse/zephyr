config CLOCK_MANAGEMENT_NXP_KINETIS
	bool
	help
	  NXP Kinetis clock management drivers

config CLOCK_MANAGEMENT_NXP_KINETIS_OSC
	bool "NXP Kinetis system oscillator driver"
	default y
	depends on DT_HAS_NXP_KINETIS_OSC_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis system oscillator (OSC) driver. Programs the oscillator
	  range, gain and load capacitance from devicetree properties.

config CLOCK_MANAGEMENT_NXP_KINETIS_CLOCK_GATE
	bool "NXP Kinetis 8-bit clock gate driver"
	default y
	depends on DT_HAS_NXP_KINETIS_CLOCK_GATE_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis clock gate driver for gates within the 8-bit MCG and OSC
	  register blocks.

config CLOCK_MANAGEMENT_NXP_KINETIS_RTC_OSC
	bool "NXP Kinetis RTC oscillator driver"
	default y
	depends on DT_HAS_NXP_KINETIS_RTC_OSC_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis 32.768 kHz RTC oscillator driver

config CLOCK_MANAGEMENT_NXP_KINETIS_RTC_CLKOUT
	bool "NXP Kinetis RTC 32 kHz clock output driver"
	default y
	depends on DT_HAS_NXP_KINETIS_RTC_CLKOUT_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis driver for the RTC_CR[CLKO] gate, which controls whether
	  the RTC 32 kHz clock is output to other peripherals.

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG_FCRDIV
	bool "NXP Kinetis MCG fast IRC divider driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_FCRDIV_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCG fast internal reference clock divider (FCRDIV) driver

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG_MUX
	bool "NXP Kinetis MCG multiplexer driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_MUX_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCG multiplexer driver, for the IRCS, IREFS, PLLS and
	  OSCSEL selections

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG_CLKS
	bool "NXP Kinetis MCG output clock select driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_CLKS_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCGOUTCLK source select (CLKS) and low power bypass (LP)
	  driver

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG_FRDIV
	bool "NXP Kinetis MCG FLL reference divider driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_FRDIV_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCG FLL external reference divider (FRDIV) driver

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG_FLL
	bool "NXP Kinetis MCG FLL driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_FLL_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCG frequency locked loop (FLL) driver

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG_PLL
	bool "NXP Kinetis MCG PLL driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_PLL_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCG phase locked loop (PLL) driver

config CLOCK_MANAGEMENT_NXP_KINETIS_MCG
	bool "NXP Kinetis MCG driver"
	default y
	depends on DT_HAS_NXP_KINETIS_MCG_CLK_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis MCG driver, which provides access to the MCG registers and
	  overall MCG configuration.

config CLOCK_MANAGEMENT_NXP_KINETIS_SIM_FRAC_DIV
	bool "NXP Kinetis SIM fractional divider driver"
	default y
	depends on DT_HAS_NXP_KINETIS_SIM_FRAC_DIV_ENABLED
	select CLOCK_MANAGEMENT_NXP_KINETIS
	help
	  NXP Kinetis SIM fractional clock divider driver, such as the USB
	  clock divider in SIM_CLKDIV2

if CLOCK_MANAGEMENT_NXP_KINETIS

config NXP_KINETIS_CLOCK_TIMEOUT
	int "NXP Kinetis clock status timeout (in microseconds)"
	default 1000000
	help
	  Timeout value for waiting on MCG status bits (CLKST, IREFST, PLLST,
	  IRCST, LOCK0 and OSCINIT0) to reflect a new configuration. The
	  longest expected wait is crystal oscillator startup, which can take
	  up to one second for a 32 kHz crystal.

endif # CLOCK_MANAGEMENT_NXP_KINETIS

config NXP_KINETIS_FLL_ACQUIRE_DELAY
	int "NXP Kinetis FLL acquisition delay (in microseconds)"
	default 1000
	depends on CLOCK_MANAGEMENT_NXP_KINETIS_MCG_FLL || CLOCK_MANAGEMENT_NXP_KINETIS_MCG_MUX || \
			CLOCK_MANAGEMENT_NXP_KINETIS_MCG_CLKS
	help
	  Time to wait for the FLL to lock after its reference or
	  multiplication factor changes. The FLL has no lock status bit, so
	  this should match the tfll_acquire value from the device datasheet.

config NXP_KINETIS_RTC_OSC_STARTUP_DELAY
	int "NXP Kinetis RTC oscillator startup delay (in microseconds)"
	default 0
	depends on CLOCK_MANAGEMENT_NXP_KINETIS_RTC_OSC
	help
	  Time to wait after enabling the RTC oscillator before it is treated
	  as stable. The RTC oscillator has no ready status bit. Boards that
	  use the RTC oscillator as an MCG reference should set this to the
	  crystal startup time from the device datasheet.
