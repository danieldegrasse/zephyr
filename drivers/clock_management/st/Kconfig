config CLOCK_MANAGEMENT_STM32
	bool
	help
	  STM32 clock management drivers

config CLOCK_MANAGEMENT_STM32_CLOCK_SOURCE
	bool "STM32 clock source driver"
	default y
	depends on DT_HAS_ST_STM32_CLOCK_SOURCE_ENABLED
	select CLOCK_MANAGEMENT_STM32
	help
	  STM32 clock source driver for fixed-frequency oscillators
	  that can be gated/ungated

config CLOCK_MANAGEMENT_STM32_OSC
	bool "STM32 oscillator driver"
	default y
	depends on DT_HAS_ST_STM32_OSC_ENABLED
	select CLOCK_MANAGEMENT_STM32
	help
	  STM32 oscillator driver for external oscillators with bypass support

config CLOCK_MANAGEMENT_STM32_PLL_POSTDIV
	bool "STM32 PLL post-divider driver"
	default y
	depends on DT_HAS_ST_STM32_PLL_POSTDIV_ENABLED
	select CLOCK_MANAGEMENT_STM32
	help
	  STM32 PLL output post-divider driver (P/Q/R outputs)

config CLOCK_MANAGEMENT_STM32_CLOCK_DIV
	bool "STM32 clock divider driver"
	default y
	depends on DT_HAS_ST_STM32_CLOCK_DIV_ENABLED
	select CLOCK_MANAGEMENT_STM32
	help
	  STM32 clock divider driver supporting power-of-2, linear,
	  and RTCPRE divider encodings

if CLOCK_MANAGEMENT_STM32_CLOCK_SOURCE || CLOCK_MANAGEMENT_STM32_OSC

config STM32_CLOCK_READY_TIMEOUT
	int "STM32 clock ready timeout (in microseconds)"
	default 1000
	help
	  Timeout value for waiting for STM32 clock gates to become enabled or
	  disabled after modifying their state

endif # CLOCK_MANAGEMENT_STM32_CLOCK_SOURCE || CLOCK_MANAGEMENT_STM32_OSC
