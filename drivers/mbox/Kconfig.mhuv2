config MBOX_MHUV2
	bool "ARM MHUv2 mailbox driver"
	depends on DT_HAS_ARM_MHUV2_ENABLED
	default y
	help
	  Driver for Arm MHUv2 (Message Handling Unit v2).
	  Provides doorbell or single-word signalling via the Zephyr mbox API.

if MBOX_MHUV2

config MBOX_MHUV2_NUM_CHANS
	int "ARM MHUv2 mailbox number of channels"
	range 1 124
	default 1
	help
	  Maximum number of hardware channel windows supported.
	  Must be less than or equal to MSG_NO_CAP reported by hardware.
	  MHUv2 allows up to 124 channel windows, each with 32 doorbell slots.
	  This configuration parameter is needed to avoid dynamic memory
	  allocation of per-doorbell data structures.

choice MBOX_MHUV2_PROTO
	prompt "MHUv2 transport protocol"
	default MBOX_MHUV2_PROTO_DOORBELL

config MBOX_MHUV2_PROTO_DOORBELL
	bool "Doorbell"
	help
	  Use doorbell signaling for MHUv2 transport protocol. This protocol
	  does not support data transfer, but can signal across up to 124
	  channels

config MBOX_MHUV2_PROTO_SINGLE_WORD
	bool "Single-word"
	help
	  Use single-word signaling for MHUv2 transport protocol. This protocol
	  supports data transfer using a single word and can signal across up to 4
	  channels.


endchoice

endif
