config MW405
	bool "Focus-LCD E43GB-I-MW405-C display driver"
	default y
	select MIPI_DSI
	select GPIO
	depends on DT_HAS_FOCUSLCDS_MW405_ENABLED
	help
	  Enable driver for FocusLCDs MW405 display driver.
